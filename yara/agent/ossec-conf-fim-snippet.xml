<!--
  FIM realtime monitoring - AGENT side (Linux)
  Add inside the existing <syscheck> block in /var/ossec/etc/ossec.conf
  on each Linux AGENT, then: systemctl restart wazuh-agent

  install.sh adds this automatically; this file is the manual reference.
-->
<syscheck>
  <directories realtime="yes">/tmp,/media,/root</directories>
  <directories realtime="yes" recursion_level="2">/home</directories>
</syscheck>
